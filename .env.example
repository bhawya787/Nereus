# GEMINI_API_KEY: Required if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL injected at runtime.
APP_URL="MY_APP_URL"

# Optional Copernicus Data Space Process API OAuth credentials (Sentinel-1 SAR & Sentinel-2 L2A pixel extraction)
CDSE_CLIENT_ID=""
CDSE_CLIENT_SECRET=""

# Optional Copernicus Marine Service credentials (DUACS altimetry & Surface pH acidification)
COPERNICUSMARINE_SERVICE_USERNAME=""
COPERNICUSMARINE_SERVICE_PASSWORD=""

# Optional Global Fishing Watch API v3 token (Unmatched SAR dark-vessel leads)
GFW_API_TOKEN=""

# Optional ISRO MOSDAC credentials (Oceansat-3 OCM & SCATSAT-1 layers)
MOSDAC_USERNAME=""
MOSDAC_PASSWORD=""
